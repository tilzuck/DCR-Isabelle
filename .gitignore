# Generated by `isabelle build`: keep only the PDF of the session document
/output/*
!/output/document.pdf

# LaTeX build files, e.g. from an editor compiling document/root.tex directly
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Editor and OS files
*~
.vscode/
.DS_Store
Thumbs.db
